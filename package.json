{
  "name": "burrow",
  "version": "0.1.0",
  "description": "A self-hosted localhost tunnel — what ngrok does, on your own infrastructure.",
  "type": "module",
  "license": "MIT",
  "author": "Jonghyeok Park",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "burrow": "dist/agent/index.js",
    "burrowd": "dist/relay/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:relay": "tsx src/relay/index.ts",
    "dev:agent": "tsx src/agent/index.ts",
    "start:relay": "node dist/relay/index.js",
    "start:agent": "node dist/agent/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tunnel",
    "ngrok",
    "self-hosted",
    "webhook",
    "reverse-proxy",
    "tcp"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
